# Nebius Token Factory (OpenAI-compatible)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Model IDs are checked against GET /v1/models at startup (`bumpless doctor`)
MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Free alternative (same Nemotron 3 models, NVIDIA API catalog trial; key from build.nvidia.com, starts with nvapi-).
# Costs shown are then Token Factory list-price estimates, not money spent.
# NEBIUS_API_KEY=nvapi-...
# NEBIUS_BASE_URL=https://integrate.api.nvidia.com/v1
# MODEL_NANO=nvidia/nemotron-nano-3-30b-a3b
# MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
# MODEL_ULTRA=nvidia/nemotron-3-ultra-550b-a55b

TAVILY_API_KEY=
GITHUB_TOKEN=

# docker | nebius | local
EXECUTOR=docker
MAX_RUN_COST_USD=0.50
DEMO_DAILY_BUDGET_USD=2.00
DEMO_PASSWORD=
RECIPE_MAX_AGE_DAYS=14
